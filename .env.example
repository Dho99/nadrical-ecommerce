# API Base URL 
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# WebSocket — should match backend WS endpoint (defaults to <VITE_API_BASE_URL origin>/ws).
# Only set VITE_WEBSOCKET_URL if WS is on a different host/port (e.g. wss://demo-be-eco.nadrical.my.id/ws).
# Leave empty to derive from VITE_API_BASE_URL automatically.
# VITE_WEBSOCKET_URL=wss://your-be-host/ws
# VITE_WS_HOST=127.0.0.1
# VITE_WS_PORT=8080

# Mock fallback only when backend unreachable (no flag).
VITE_USE_MOCK=true

# Google OAuth 
# VITE_GOOGLE_CLIENT_ID=