# ============================================
# NADRICAL ECOMMERCE TEMPLATE - Environment Variables
# ============================================

# API Base URL (Backend)
VITE_API_BASE_URL=

# Realtime Support (Go WebSocket Server / Backend WS)
VITE_WEBSOCKET_URL=

# Use placeholder mock API while backend is not ready. Set to false to use the real backend.
VITE_USE_MOCK=

# Google OAuth (Google Cloud Console > Credentials > OAuth client ID)
VITE_GOOGLE_CLIENT_ID=